  - message : string
  + what() : const char* {query}
  + {abstract} ~SystemException()
}
class UserException
class EnrolmentException
class AttendanceException
class PersistenceException

class UserNotFoundException {
  - userId : string
}
class InvalidCredentialsException

class PrerequisiteNotMetException {
  - courseCode : string
  - missingPrereq : string
}
class CourseFullException {
